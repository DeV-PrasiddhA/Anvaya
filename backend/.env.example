PORT=5001

# Comma-separated frontend origins allowed to call the Express API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

APP_NAME=Anvaya Market Intelligence API
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Gemini is used to translate Kalimati commodity names into English.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
KALIMATI_RETENTION_DAYS=7

# Supabase Credentials
# Find these in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key

# Optional PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/database
